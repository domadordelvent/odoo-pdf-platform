# Copy to .env only for a new installation. Never overwrite an existing .env.
# .env is ignored by Git. Keep its permissions at 0600.
POSTGRES_USER=odoo

# Required: supply a strong private password before starting a NEW database.
# Existing PostgreSQL volumes require their existing password; this variable
# does not rotate the password of an initialized PostgreSQL role.
POSTGRES_PASSWORD=

# Required: supply a different strong private password for Odoo database
# management. This is separate from PostgreSQL and from web login passwords.
ODOO_MASTER_PASSWORD=
