<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pdf_job_list" model="ir.ui.view">
        <field name="name">pdf.job.list</field>
        <field name="model">pdf.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="operation"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_pdf_job_form" model="ir.ui.view">
        <field name="name">pdf.job.form</field>
        <field name="model">pdf.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_process"
                        type="object"
                        string="Process"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_reset_to_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state != 'failed'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,processing,done,failed"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="operation"/>
                        <field name="state"/>
                        <field name="rotation_angle" invisible="operation != 'rotate'"/>
                        <field
                            name="compression_level"
                            invisible="operation != 'compress'"
                        />
                        <field name="error_message"/>
                        <field name="input_attachment_ids" widget="many2many_binary"/>
                        <field name="output_attachment_ids" widget="many2many_binary"/>
                        <field
                            name="page_selection"
                            invisible="operation not in ['extract', 'reorder']"
                            placeholder="1,3,5-8,12"
                        />
                        <field
                            name="watermark_text"
                            invisible="operation != 'watermark'"
                            placeholder="CONFIDENTIAL"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pdf_jobs" model="ir.actions.act_window">
        <field name="name">PDF Jobs</field>
        <field name="res_model">pdf.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pdf_root" name="PDF Platform"/>
    <menuitem
        id="menu_pdf_jobs"
        name="Jobs"
        parent="menu_pdf_root"
        action="action_pdf_jobs"
    />
</odoo>
