<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pdf_job_list" model="ir.ui.view">
        <field name="name">pdf.job.list</field>
        <field name="model">pdf.job</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc, id desc">
                <field name="name" string="Job Name"/>
                <field name="operation" width="150px"/>
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state == 'draft'"
                    decoration-info="state == 'processing'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'failed'"
                    width="120px"
                />
                <field name="create_date" string="Created on" width="180px"/>
            </list>
        </field>
    </record>

    <record id="view_pdf_job_form" model="ir.ui.view">
        <field name="name">pdf.job.form</field>
        <field name="model">pdf.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_process"
                        type="object"
                        string="Process"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_reset_to_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state != 'failed'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,processing,done,failed"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Job Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Monthly reports"/>
                        </h1>
                    </div>

                    <group string="General / Operation Settings" col="2">
                        <field name="operation"/>
                        <field name="rotation_angle" invisible="operation != 'rotate'"/>
                        <field
                            name="compression_level"
                            invisible="operation != 'compress'"
                        />
                        <field
                            name="page_selection"
                            invisible="operation not in ['extract', 'reorder']"
                            placeholder="1,3,5-8,12"
                        />
                        <field
                            name="watermark_text"
                            invisible="operation != 'watermark'"
                            placeholder="CONFIDENTIAL"
                        />
                    </group>

                    <separator string="Input PDFs"/>
                    <field name="input_attachment_ids" widget="many2many_binary" nolabel="1"/>

                    <div invisible="state not in ['done', 'failed'] and not output_attachment_ids and not error_message">
                        <separator string="Result / Output PDFs"/>
                        <div class="alert alert-success py-2" role="status" invisible="state != 'done'">
                            <i class="fa fa-check-circle me-1" title="Completed"/>
                            Processing complete. Your output PDFs are ready below.
                        </div>
                        <div class="alert alert-danger py-2" role="alert" invisible="state != 'failed' and not error_message">
                            <label for="error_message" string="Error Message" class="fw-bold"/>
                            <field name="error_message" nolabel="1"/>
                        </div>
                        <field
                            name="output_attachment_ids"
                            widget="many2many_binary"
                            nolabel="1"
                            invisible="not output_attachment_ids"
                        />
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pdf_jobs" model="ir.actions.act_window">
        <field name="name">PDF Jobs</field>
        <field name="res_model">pdf.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pdf_root" name="PDF Platform"/>
    <menuitem
        id="menu_pdf_jobs"
        name="Jobs"
        parent="menu_pdf_root"
        action="action_pdf_jobs"
    />
</odoo>
