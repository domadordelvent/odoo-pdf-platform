<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pdf_job_form" model="ir.ui.view">
        <field name="name">pdf.job.form</field>
        <field name="model">pdf.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                   
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,processing,done,failed"
                    />
                </header>

                <sheet>
                    <div class="oe_title mb-4">
                        <label for="name" string="Job Name"/>
                        <h1>
                            <field name="name"
                                placeholder="e.g. Monthly reports"
                                readonly="state != 'draft'"/>
                        </h1>
                    </div>

                    <div class="row g-4">

                        <!-- Operation -->
                        <div class="col-lg-5">
                            <div class="border rounded p-3 h-100">
                               <h5 class="mb-2">
                                    <i class="fa fa-cogs me-2 text-primary"/>
                                    Choose an operation
                                </h5>

                                <p class="text-muted mb-3">
                                    Select what you want to do with your PDF files.
                                </p>


                                <field
                                    name="operation"
                                    widget="pdf_operation_selector"
                                    required="1"
                                    nolabel="1"
                                    readonly="state != 'draft'"
                                />

                              
                                <group class="mt-4">
                                    <field
                                        name="rotation_angle"
                                        invisible="operation != 'rotate'"
                                        readonly="state != 'draft'"
                                    />

                                    <field
                                        name="compression_level"
                                        invisible="operation != 'compress'"
                                        readonly="state != 'draft'"
                                    />

                                    <field
                                        name="page_selection"
                                        invisible="operation not in ['extract', 'reorder']"
                                        placeholder="1,3,5-8,12"
                                        readonly="state != 'draft'"
                                    />

                                    <field
                                        name="watermark_text"
                                        invisible="operation != 'watermark'"
                                        placeholder="CONFIDENTIAL"
                                        readonly="state != 'draft'"
                                    />
                                </group>
                              
                            </div>
                        </div>

                        <!-- Input PDFs -->
                        <div class="col-lg-7">
                            <div class="border rounded p-3 h-100">
                                <h5 class="mb-3">
                                    <i class="fa fa-file-pdf-o me-2 text-primary"/>
                                    Input PDFs
                                </h5>

                                <field
                                    name="input_attachment_ids"
                                    widget="pdf_attachment"
                                    nolabel="1"
                                    readonly="state != 'draft'"
                                />
                            </div>
                        </div>

                    </div>

                    <!-- Output -->
                    <div
                        class="mt-4"
                        invisible="state not in ['done', 'failed'] and not output_attachment_ids and not error_message"
                    >

                         


                        <div class="border rounded p-3">
                            <h5 class="mb-3">
                                <i class="fa fa-check-circle me-2 text-primary"/>
                                Result / Output PDFs
                            </h5>

                            <div
                                class="alert alert-success py-2"
                                role="status"
                                invisible="state != 'done'"
                            >
                                <i class="fa fa-check-circle me-1"/>
                                Processing complete. Your output PDFs are ready.
                            </div>

                            <div
                                class="alert alert-danger py-2"
                                role="alert"
                                invisible="state != 'failed' and not error_message"
                            >
                                <label
                                    for="error_message"
                                    string="Error Message"
                                    class="fw-bold"
                                />


                               


                                <field name="error_message" nolabel="1"/>
                                <div class="mt-3">
                                    <button name="action_reset_to_draft"
                                        string="Fix and Retry"
                                        type="object"
                                        class="btn-primary"
                                        invisible="state != 'failed'"/>
                                </div>


                            </div>

                            <field
                                name="output_attachment_ids"
                                widget="many2many_binary"
                                nolabel="1"
                                invisible="not output_attachment_ids"
                            />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4"
                        invisible="state != 'draft'">
                        <button
                            name="action_process"
                            type="object"
                            string="Process PDF"
                            class="btn btn-primary btn-lg px-5"
                            icon="fa-play"
                        />
                    </div>


                </sheet>
            </form>
        </field>
    </record>
</odoo>
